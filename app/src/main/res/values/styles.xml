<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.EPS" parent="Theme.AppCompat.NoActionBar">
        <!-- 整个窗口（含打开瞬间、页面切换、加载/成功/失败任何状态）都是喜庆大红底 -->
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:colorBackground">@color/festive_red</item>
        <item name="android:statusBarColor">@color/festive_red_top</item>
        <item name="android:navigationBarColor">@color/festive_red_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="colorPrimary">@color/festive_red</item>
        <item name="colorPrimaryDark">@color/festive_red_top</item>
        <item name="colorAccent">@color/festive_red</item>
        <item name="colorControlActivated">@color/festive_red</item>
        <item name="android:textColorPrimary">@color/text_dark</item>

        <item name="buttonStyle">@style/EPS.Button</item>
        <item name="android:buttonStyle">@style/EPS.Button</item>
    </style>

    <!-- 主要按钮：喜庆红实心 + 白字 -->
    <style name="EPS.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/on_red_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 次要按钮：浅底红字 -->
    <style name="EPS.Button.Light">
        <item name="android:background">@drawable/bg_btn_light</item>
        <item name="android:textColor">@color/festive_red</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>

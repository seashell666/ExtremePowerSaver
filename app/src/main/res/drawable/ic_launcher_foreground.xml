        <path android:pathData="M60,18 L32,58 L52,58 L48,90 L78,48 L56,48 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="76"
                    android:endY="90"
                    android:startX="34"
                    android:startY="18"
                    android:type="linear">
                    <item
                        android:color="#FFFFE07A"
                        android:offset="0" />
                    <item
                        android:color="#FFFFC61A"
                        android:offset="0.5" />
                    <item
                        android:color="#FFE89600"

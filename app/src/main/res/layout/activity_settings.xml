<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.03"
            android:text="超级省电"
            android:textColor="@color/on_red_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="MIUI 超级省电 · 打开即切换"
            android:textColor="@color/on_red_secondary"
            android:textSize="12sp" />

        <!-- 卡片一：命令设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="命令设置"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="root 执行"
                    android:textColor="@color/festive_red"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="打开 App 时会自动执行下面这条命令（以 root 身份）。"
                android:textColor="@color/text_body"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPresetEnter"
                    style="@style/EPS.Button.Light"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="进入超级省电" />

                <Button
                    android:id="@+id/btnPresetExit"
                    style="@style/EPS.Button.Light"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="退出超级省电" />
            </LinearLayout>

            <EditText
                android:id="@+id/editCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:fontFamily="monospace"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="5"
                android:padding="12dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_hint"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbToast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/festive_red"
                android:checked="true"
                android:text="执行后弹出提示"
                android:textColor="@color/text_body"
                android:textSize="13sp"
                app:buttonTint="@color/festive_red" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTest"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="立即测试" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="保存" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:textColor="@color/text_body"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 卡片二：充电自动退出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="充电自动退出"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="满 77%"
                    android:textColor="@color/festive_red"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="插上电源（有线/无线）后 1 秒内自动退出超级省电。如果充电时仍处于超级省电，电量超过 77% 会自动退出并立刻息屏。由 Magisk 的 service.d 守护进程实现，开机自启，不依赖本 App 是否运行。"
                android:textColor="@color/text_body"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbAutoExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/festive_red"
                android:text="充电时自动退出超级省电"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                app:buttonTint="@color/festive_red" />

            <TextView
                android:id="@+id/tvWatchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:text="状态：查询中…"
                android:textColor="@color/text_body"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 卡片三：闲置息屏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="闲置息屏"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="7 分 27 秒"
                    android:textColor="@color/festive_red"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="连续 7 分 27 秒（447 秒）没有任何触屏（只认真实触屏，不看按键、传感器），就先退回桌面默认主页面、再息屏，全程约 1 秒。超级省电模式下不生效。"
                android:textColor="@color/text_body"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbIdle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/festive_red"
                android:text="7 分 27 秒无触屏自动息屏"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                app:buttonTint="@color/festive_red" />
        </LinearLayout>

        <!-- 卡片四：息屏归位主屏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="息屏归位主屏"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="7 秒"
                    android:textColor="@color/festive_red"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="在桌面（但不在第一页）的时候息屏，7 秒后桌面会在黑屏状态下自己翻回主屏幕，下次亮屏看到的就是主屏。全程不会点亮屏幕；7 秒内重新亮屏则保持原样。回到的是桌面第一页，不是别的 App。"
                android:textColor="@color/text_body"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/festive_red"
                android:text="息屏 7 秒后回到主屏幕"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                app:buttonTint="@color/festive_red" />

            <CheckBox
                android:id="@+id/cbResetSilent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="2dp"
                android:buttonTint="@color/festive_red"
                android:checked="true"
                android:text="跳过过渡空白（亮屏直接是完整主屏）"
                android:textColor="@color/text_body"
                android:textSize="13sp"
                app:buttonTint="@color/festive_red" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="勾选后不重建桌面，改成息屏期间短暂点亮一次显示、把背光压到 0，桌面自己滑回第一页——亮屏第一帧就是完整主屏。取消勾选则用重建方式，亮屏时会有约 0.6 秒只显示壁纸。"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 卡片五：彩蛋 · NFC 刷卡弹窗 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NFC 刷卡弹窗"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="彩蛋"
                    android:textColor="@color/festive_red"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="刷门禁、坐公交时，小米智能卡会把整页「请靠近读卡器」顶到前台，正在用的 App 被挤到后台，还得手动切回来。勾选后直接关掉这个界面：卡片照常刷（NFC 卡模拟走的是安全芯片服务，不经过这个界面），只是不再弹窗。"
                android:textColor="@color/text_body"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbNfcBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/festive_red"
                android:checked="true"
                android:text="屏蔽 NFC 刷卡弹窗"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                app:buttonTint="@color/festive_red" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="它和「双击电源键唤起刷卡页」是同一个界面，所以勾选后双击电源键也不会再唤起；想用就回来取消勾选，组件会立刻恢复。"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="3dp"
            android:text="说明：这条命令通过 MIUI 电量和性能的 PowerSaverProvider 调用 changeSuperPowerMode，与手动点开关效果完全一致。"
            android:textColor="#CCFFE6DF"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
